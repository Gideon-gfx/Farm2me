# PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/farm2me?schema=public"

# Secret used to sign JWT access tokens
JWT_SECRET="change-me-to-a-long-random-string"

# Monnify payment gateway credentials
MONNIFY_API_KEY=""
MONNIFY_CLIENT_SECRET=""
MONNIFY_BASE_URL="https://sandbox.monnify.com"
MONNIFY_CONTRACT_CODE=""
MONNIFY_WALLET_ACCOUNT=""
MONNIFY_REDIRECT_URL="http://localhost:4000/payment-complete"

# Infobip SMS / OTP provider — INFOBIP_BASE_URL is account-specific
# (Infobip Portal → Homepage shows your base URL, e.g. "xxxxxxx.api.infobip.com")
INFOBIP_API_KEY=""
INFOBIP_BASE_URL=""
INFOBIP_SENDER_ID="Farm2Me"

# Cloudinary media storage (format: cloudinary://api_key:api_secret@cloud_name)
CLOUDINARY_URL=""

# Google Sign-In OAuth Web Client ID (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=""

# Transactional email via real SMTP (Nodemailer) — used for the welcome
# email on signup and the "forgot password" reset link. Works with any SMTP
# provider: a Gmail account + app password, SendGrid/Mailgun/SES SMTP
# credentials, Mailtrap for testing, etc.
# Left blank in local dev: emails are logged to the console instead of sent,
# and the reset link is also echoed back directly in the API response.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL="Farm2Me <no-reply@farm2me.com>"

# Frontend origins a password-reset link may point to.
WEB_APP_URL="http://localhost:5173"
ADMIN_APP_URL="http://localhost:5266/admin"

# HTTP port the server listens on
PORT=4000

# Admin account seeded by `npm run seed` (prisma/seed.ts) — logs into the
# admin dashboard with these credentials.
SEED_ADMIN_EMAIL="admin@farm2me.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Farm2Me Admin"
